root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Python uses 4-space indentation (PEP 8)
[*.py]
indent_size = 4

# Go uses tabs (gofmt standard)
[*.go]
indent_style = tab
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab

# Markdown: keep trailing whitespace (two spaces = a line break). Prose wraps
# at 80, enforced by Prettier (proseWrap: always) via task format:docs and CI.
[*.md]
trim_trailing_whitespace = false
max_line_length = 80
