VITE_APP_API_URL=http://localhost:8000
VITE_APP_FONT_SOURCE=local
VITE_APP_TITLE=DelveMoar
# Sentry DSN for browser error tracking. Leave empty/unset to disable (the
# default for local dev and CI). Production sets it in the Vercel project.
VITE_APP_SENTRY_DSN=

# Plausible analytics. Leave ANALYTICS_DOMAIN empty/unset to disable (the
# default for dev, CI, and self-hosters who opt out). When set, it is the
# Plausible data-domain. ANALYTICS_SRC defaults to Plausible cloud; self-hosters
# override it to their own instance's script. See docs/analytics.md.
VITE_APP_ANALYTICS_DOMAIN=
VITE_APP_ANALYTICS_SRC=https://plausible.io/js/script.js
