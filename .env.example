# Copy this file to .env and fill in values before running `task dev`.
# .env is gitignored — never commit secrets.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=dm
POSTGRES_PASSWORD=dm_secret
POSTGRES_DB=delve_moar

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# asyncpg connection URL used by SQLAlchemy and Alembic
DATABASE_URL=postgresql+asyncpg://dm:dm_secret@localhost:5432/delve_moar
API_PORT=8000
ENV=development
VERSION=0.0.1
# Base URL used in error response more_info links — no trailing slash
PUBLIC_URL=http://localhost:8000
# Comma-separated list of origins allowed to make cross-origin requests
# to the API.  Defaults to the local web dev server; production deploys
# override with the public web origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
WEB_PORT=5173
