# Copy this file to .env and fill in values before running `task dev`.
# .env is gitignored — never commit secrets.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=dm
POSTGRES_PASSWORD=dm_secret
POSTGRES_DB=delve_moar

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# asyncpg connection URL used by SQLAlchemy and Alembic
DATABASE_URL=postgresql+asyncpg://dm:dm_secret@localhost:5432/delve_moar
API_PORT=8000
ENV=development
VERSION=0.0.1
# Base URL used in error response more_info links — no trailing slash
PUBLIC_URL=http://localhost:8000
# Comma-separated list of origins allowed to make cross-origin requests
# to the API.  Defaults to the local web dev server; production deploys
# override with the public web origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database connection pool. DB_POOL_PRE_PING checks a pooled connection for
# liveness on checkout and reconnects if it was closed server-side (e.g. the
# Fly proxy dropping an idle connection, or a DB restart); leave it on.
# DB_POOL_RECYCLE_SECONDS caps a connection's age (-1 disables).
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800

# ---------------------------------------------------------------------------
# Auth (Phase 1b)
# ---------------------------------------------------------------------------
# argon2id password-hashing cost parameters (OWASP minimums; raise as
# hardware allows). Memory cost is in KiB.
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
# Session lifetime in seconds (sliding). 1209600 = 14 days.
SESSION_TTL_SECONDS=1209600
SESSION_COOKIE_NAME=dm_session
CSRF_COOKIE_NAME=dm_csrf
# Secure flag on auth cookies. Leave false for local plain-HTTP dev; in
# production it defaults to true (derived from ENV) when left unset.
SESSION_COOKIE_SECURE=false
# Cookie Domain. Empty = host-only (correct for local dev). In production
# set the shared parent, e.g. .delvemoar.com, so the web origin can read
# the CSRF cookie set by the API subdomain.
SESSION_COOKIE_DOMAIN=

# Rate limiting on auth endpoints (brute-force + abuse protection). Limits
# use `limits` library notation (e.g. 10/minute, 5/hour;100/day) and are
# keyed by client IP. Set RATE_LIMIT_ENABLED=false to disable entirely.
# Storage defaults to in-process memory; point it at async+redis://... to
# share counters across machines if the API ever runs more than one.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=async+memory://
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/hour
# Per-IP limits on the email-sending auth endpoints (anti mail-bombing).
RATE_LIMIT_PASSWORD_RESET=5/hour
RATE_LIMIT_RESEND_VERIFICATION=5/hour
RATE_LIMIT_EMAIL_CHANGE=5/hour
# Per-IP cap on creating campaign invites (blunts handle enumeration + spam).
RATE_LIMIT_CAMPAIGN_INVITE=30/hour

# ---------------------------------------------------------------------------
# Email / mailer (Phase 1b)
# ---------------------------------------------------------------------------
# Base URL of the web app, used to build the links in verification and
# password-reset emails (no trailing slash). The matching routes are owned
# by the web app.
FRONTEND_BASE_URL=http://localhost:5173
# Delivery backend: "console" logs the message (zero-config dev/CI/self-host)
# or "smtp" to deliver via an SMTP server.
MAILER_TRANSPORT=console
# From header on outgoing mail.
MAILER_FROM=DelveMoar <no-reply@delvemoar.com>
# SMTP connection (only used when MAILER_TRANSPORT=smtp). Defaults target a
# local Mailpit (host localhost, port 1025, no TLS).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Implicit TLS (port 465) vs STARTTLS (port 587); set at most one true.
SMTP_USE_TLS=false
SMTP_START_TLS=false
# Single-use token lifetimes in seconds. 86400 = 24h verify; 3600 = 1h for
# both password reset and email-change confirmation.
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_CHANGE_TTL_SECONDS=3600
# How long a pending campaign invite stays actionable. 1209600 = 14 days.
CAMPAIGN_INVITE_TTL_SECONDS=1209600

# ---------------------------------------------------------------------------
# Observability / error tracking (Phase 1b)
# ---------------------------------------------------------------------------
# Sentry DSN for the API. Leave empty to disable error tracking entirely
# (the default for local dev, CI, and tests). Production sets it as a secret.
SENTRY_DSN=
# Sentry environment tag. Empty falls back to ENV (e.g. development/production).
SENTRY_ENVIRONMENT=
# Performance-tracing sample rate (0.0 = errors only; stay within free quota).
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
WEB_PORT=5173
